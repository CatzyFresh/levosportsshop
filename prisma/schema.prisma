generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        Int        @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  batch     String?
  invoices  Invoice[]
  purchases Purchase[]

  @@map("players")
}

model StoreItem {
  id           Int        @id @default(autoincrement())
  name         String
  defaultPrice Int        @map("default_price")
  stockTracked Boolean    @default(false) @map("stock_tracked")
  currentStock Int?       @map("current_stock")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  purchases    Purchase[]

  @@map("store_items")
}

model Purchase {
  id           Int        @id @default(autoincrement())
  playerId     Int        @map("player_id")
  storeItemId  Int?       @map("store_item_id")
  invoiceId    Int?       @map("invoice_id")
  itemName     String     @map("item_name")
  unitPrice    Int        @map("unit_price")
  quantity     Int        @default(1)
  totalAmount  Int        @map("total_amount")
  purchaseDate DateTime   @map("purchase_date")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  invoice      Invoice?   @relation(fields: [invoiceId], references: [id])
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  storeItem    StoreItem? @relation(fields: [storeItemId], references: [id])

  @@map("purchases")
}

model Invoice {
  id          Int           @id @default(autoincrement())
  playerId    Int           @map("player_id")
  month       Int
  year        Int
  dueDate     DateTime?     @map("due_date")
  totalAmount Int           @default(0) @map("total_amount")
  paidAmount  Int           @default(0) @map("paid_amount")
  balance     Int           @default(0)
  status      InvoiceStatus @default(UNPAID)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  player      Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  payments    Payment[]
  purchases   Purchase[]

  @@unique([playerId, month, year])
  @@map("invoices")
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int      @map("invoice_id")
  amount    Int
  paidAt    DateTime @default(now()) @map("paid_at")
  method    String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
  OVERDUE
}
